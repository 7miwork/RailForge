[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/debug_overlay.gd" id="1"]

[node name="DebugOverlay" type="CanvasLayer"]
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -240.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = 16.0
grow_horizontal = 0

[node name="VBox" type="VBoxContainer" parent="Panel"]
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="Panel/VBox"]
text = "Debug"

[node name="EraRow" type="HBoxContainer" parent="Panel/VBox"]
theme_override_constants/separation = 6

[node name="EraLabel" type="Label" parent="Panel/VBox/EraRow"]
text = "Ära:"

[node name="EraOption" type="OptionButton" parent="Panel/VBox/EraRow"]
size_flags_horizontal = 3

[node name="ItemRow" type="HBoxContainer" parent="Panel/VBox"]
theme_override_constants/separation = 4

[node name="DeleteButton" type="Button" parent="Panel/VBox"]
text = "Save löschen"

[node name="InfoLabel" type="Label" parent="Panel/VBox"]
text = "Kein Save vorhanden"

[node name="ConfirmDialog" type="ConfirmationDialog" parent="."]
title = "Save löschen?"
dialog_text = "Der aktuelle Spielstand wird unwiderruflich gelöscht."
ok_button_text = "Löschen"

[connection signal="pressed" from="Panel/VBox/DeleteButton" to="." method="_on_delete_pressed"]
[connection signal="confirmed" from="ConfirmDialog" to="." method="_on_confirm_delete"]
